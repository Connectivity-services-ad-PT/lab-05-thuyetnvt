{
  "info": {
    "name": "FIT4110 Lab05 Docker Compose",
    "description": "Minimal Postman collection for Lab 05 service readiness and API verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "API Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('API health returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "AI Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:9000/health",
          "host": ["http://localhost:9000"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('AI health returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "AI Predict",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "http://localhost:9000/predict",
          "host": ["http://localhost:9000"],
          "path": ["predict"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('AI predict returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('AI predict returns objects', function () {",
              "    pm.expect(jsonData.objects.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Reading",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 24.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-06-09T10:00:00+07:00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/readings",
          "host": ["{{baseUrl}}"],
          "path": ["readings"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Create reading returns 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.environment.set('reading_id', jsonData.reading_id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Latest Readings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/readings/latest",
          "host": ["{{baseUrl}}"],
          "path": ["readings", "latest"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Latest readings returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Latest readings contains at least one item', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.items.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Reading by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/readings/{{reading_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["readings", "{{reading_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Get reading by ID returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Get reading by ID returns reading_id', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.reading_id).to.eql(pm.environment.get('reading_id'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
